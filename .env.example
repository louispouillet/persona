# Encryption key for n8n credentials (long random string).
# Generated automatically by `make up`, or by hand with: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me

# Public URL of n8n (keep the default when running locally).
WEBHOOK_URL=http://localhost:5678/

# Secrets of the shared n8n credentials, loaded into n8n with `make credentials`.
# SMTP account that sends every email (Gmail: smtp.gmail.com, port 465, an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Google AI Studio API key used by every Gemini node.
GEMINI_API_KEY=

# Secret that signs the unsubscribe links. Generate with: openssl rand -hex 32
UNSUBSCRIBE_HMAC_SECRET=

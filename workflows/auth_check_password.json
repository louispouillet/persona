      "id": "fe376f73-a9df-4051-80de-df15d05ef084",
      "name": "Hash password attempt"
    },
    {
      "parameters": {
        "jsCode": "const t = $('Trigger').first().json;\nconst candidate = $input.first().json.candidate_hash;\nconst userId = Number(t.user_id);\nconst failedBefore = Number(t.failed_logins) || 0;\n\n// still locked: refuse without counting the attempt\nif (t.locked_until && new Date(t.locked_until) > new Date()) {\n  return [{ json: { ok: false, userId, failed: failedBefore, lockedUntil: t.locked_until } }];\n}\nconst ok = candidate === t.password_hash;\n// once a lock has expired, start a fresh series of attempts\nconst previous = failedBefore >= 5 ? 0 : failedBefore;\nconst failed = ok ? 0 : previous + 1;\nconst lockedUntil = !ok && failed >= 5 ? new Date(Date.now() + 15 * 60 * 1000).toISOString() : null;\nreturn [{ json: { ok, userId, failed, lockedUntil } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],

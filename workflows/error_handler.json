    {
      "parameters": {
        "jsCode": "function getFailure(data) {\n  if (data.execution) {\n    return {\n      error: data.execution.error || {},\n      node: data.execution.error?.node?.name || data.execution.lastNodeExecuted || 'unknown',\n      mode: data.execution.mode,\n      link: data.execution.url || 'execution not saved',\n    };\n  }\n  return {\n    error: data.trigger?.error || {},\n    node: 'trigger',\n    mode: data.trigger?.mode || 'trigger',\n    link: 'the workflow could not start',\n  };\n}\n\nfunction buildText(workflowName, failure) {\n  return [\n    `The workflow \"${workflowName}\" failed.`,\n    '',\n    `Node: ${failure.node}`,\n    `Error: ${failure.error.message || 'unknown error'}`,\n    `Mode: ${failure.mode}`,\n    `Execution: ${failure.link}`,\n    `Date: ${new Date().toISOString()}`,\n  ].join('\\n');\n}\n\nconst data = $input.first().json;\nconst workflowName = data.workflow?.name || 'Unknown workflow';\nconst failure = getFailure(data);\n\nreturn [{ json: { subject: `[Persona] ${workflowName} failed`, text: buildText(workflowName, failure) } }];\n"
      },

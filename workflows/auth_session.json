      "name": "Hash login attempt"
    },
    {
      "parameters": {
        "jsCode": "const sessionId = $('Trigger').first().json.sessionId;\nif (!sessionId) {\n  return [{ json: { ok: false, message: 'Missing session id.' } }];\n}\n\nconst user = $('Find user for login').first().json;\nconst candidate = $input.first().json.candidate_hash;\n\nif (!user.id) {\n  return [{ json: { ok: false, message: 'Incorrect email or password.' } }];\n}\n\nif (user.locked_until && new Date(user.locked_until) > new Date()) {\n  return [{ json: { ok: false, userId: user.id, failed: user.failed_logins || 0, lockedUntil: user.locked_until, message: 'Incorrect email or password.' } }];\n}\n\nconst passwordOk = candidate === user.password_hash;\nconst verified = user.email_verified === true;\n// once a lock has expired, start a fresh series of attempts\nconst previous = (user.failed_logins || 0) >= 5 ? 0 : (user.failed_logins || 0);\nconst failed = passwordOk ? 0 : previous + 1;\nconst lockedUntil = !passwordOk && failed >= 5\n  ? new Date(Date.now() + 15 * 60 * 1000).toISOString()\n  : null;\n\n// the \"not verified\" hint is only given to someone who knows the password\nconst message = !passwordOk\n  ? 'Incorrect email or password.'\n  : !verified\n    ? 'Email not verified yet. Enter the code sent by email, or ask for a new code.'\n    : 'Login successful.';\n\nreturn [{ json: { ok: passwordOk && verified, userId: user.id, failed, lockedUntil, message } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

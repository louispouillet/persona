        "jsCode": "const owner = $input.first().json;\nconst { userId, salt, emailChanged, values } = $('Validate profile').first().json;\nif (owner.id && owner.id !== userId) {\n  return [{ json: { ok: false, message: 'This email is already used by another account.' } }];\n}\nreturn [{ json: { ok: true, userId, salt, emailChanged, values } }];"

      "id": "6ef17925-4871-4d79-ad9d-e113791e63a4",
      "name": "Find current user",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const user = $input.first().json;\nconst input = $('Trigger').first().json;\nif (!user.id) {\n  return [{ json: { ok: false, message: 'Account not found.' } }];\n}\n// an empty string means \"not provided\"\nconst given = (v) => v !== '';\n// the newsletter can only match articles on these categories (set by News Classify)\nconst CATEGORIES = ['tech', 'science', 'business', 'politics', 'world', 'health', 'sports', 'culture', 'environment', 'entertainment'];\nconst values = {\n  email: user.email,\n  interests: user.interests,\n  send_hour: user.send_hour,\n  timezone: user.timezone,\n  email_verified: user.email_verified === true,\n};\nlet emailChanged = false;\nlet changed = 0;\n\nif (given(input.email)) {\n  const email = input.email;\n  if (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) {\n    return [{ json: { ok: false, message: 'Invalid email.' } }];\n  }\n  if (email !== user.email) {\n    values.email = email;\n    values.email_verified = false;\n    emailChanged = true;\n  }\n  changed++;\n}\n\nif (given(input.interests)) {\n  const topics = [...new Set(\n    input.interests.split(/[,;\\n]/).map((t) => t.toLowerCase().trim().replace(/\\s+/g, ' ')).filter(Boolean)\n  )];\n  if (topics.length === 0 || topics.length > 10) {\n    return [{ json: { ok: false, message: 'Give between 1 and 10 interests.' } }];\n  }\n  const unknown = topics.filter((t) => !CATEGORIES.includes(t));\n  if (unknown.length > 0) {\n    return [{ json: { ok: false, message: `Unknown interests: ${unknown.join(', ')}. Choose among: ${CATEGORIES.join(', ')}.` } }];\n  }\n  values.interests = topics.join(',');\n  changed++;\n}\n\nif (given(input.send_hour)) {\n  const m = input.send_hour.trim().match(/^([01]?\\d|2[0-3])(?::([0-5]\\d))?$/);\n  if (!m) {\n    return [{ json: { ok: false, message: 'Invalid send time. Use an hour between 0 and 23, for example 8 or 18:30.' } }];\n  }\n  values.send_hour = m[1].padStart(2, '0') + ':' + (m[2] || '00');\n  changed++;\n}\n\nif (given(input.timezone)) {\n  const tz = input.timezone.trim();\n  try {\n    new Intl.DateTimeFormat('en', { timeZone: tz });\n  } catch (e) {\n    return [{ json: { ok: false, message: 'Invalid timezone. Use an IANA name such as Europe/Paris.' } }];\n  }\n  values.timezone = tz;\n  changed++;\n}\n\nif (changed === 0) {\n  return [{ json: { ok: false, message: 'Nothing to update.' } }];\n}\nreturn [{ json: { ok: true, userId: user.id, salt: user.salt, emailChanged, values } }];"
      },
      "type": "n8n-nodes-base.code",

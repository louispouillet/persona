  "nodes": [
    {
      "parameters": {
        "jsCode": "const { email, password, language, consent } = $('Trigger').first().json;\n\nconst ISO_639_1 = new Set(\n  'aa ab ae af ak am an ar as av ay az ba be bg bh bi bm bn bo br bs ca ce ch co cr cs cu cv cy da de dv dz ee el en eo es et eu fa ff fi fj fo fr fy ga gd gl gn gu gv ha he hi ho hr ht hu hy hz ia id ie ig ii ik io is it iu ja jv ka kg ki kj kk kl km kn ko kr ks ku kv kw ky la lb lg li ln lo lt lu lv mg mh mi mk ml mn mr ms mt my na nb nd ne ng nl nn no nr nv ny oc oj om or os pa pi pl ps pt qu rm rn ro ru rw sa sc sd se sg si sk sl sm sn so sq sr ss st su sv sw ta te tg th ti tk tl tn to tr ts tt tw ty ug uk ur uz ve vi vo wa wo xh yi yo za zh zu'.split(' ')\n);\n\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) {\n  return [{ json: { ok: false, message: 'Invalid email.' } }];\n}\nif (!password || password.length < 8) {\n  return [{ json: { ok: false, message: 'Password too short (minimum 8 characters).' } }];\n}\nif (!ISO_639_1.has(language)) {\n  return [{ json: { ok: false, message: 'Invalid language. Use a two-letter ISO 639-1 code such as \"fr\" or \"en\".' } }];\n}\nif (consent !== true) {\n  return [{ json: { ok: false, message: 'Consent required. Explain that the email, interests and send time are stored to send the newsletter and that the account can be deleted at any time, then ask the user to accept explicitly.' } }];\n}\nreturn [{ json: { ok: true, email, language } }];"
      },

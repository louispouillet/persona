    },
    {
      "parameters": {
        "jsCode": "const user = $('Find user for verify').first().json;\nconst given = $('Trigger').first().json.code;\nconst sessionId = $('Trigger').first().json.sessionId;\nconst candidate = $input.first().json.candidate_hash;\nconst MAX_ATTEMPTS = 5;\nconst refuse = (message) => [{ json: { ok: false, save: false, message } }];\n\nif (!user.id) return refuse('Invalid or expired code.');\nif (user.email_verified === true) return refuse('This email is already verified. You can log in.');\nif (!user.verify_code_hash || !user.verify_expires || new Date(user.verify_expires) <= new Date()) {\n  return refuse('Invalid or expired code. Ask for a new code.');\n}\nconst attempts = user.verify_attempts || 0;\nif (attempts >= MAX_ATTEMPTS) return refuse('Too many attempts. Ask for a new code.');\n\nconst ok = /^\\d{6}$/.test(given) && candidate === user.verify_code_hash;\nreturn [{ json: {\n  ok,\n  // a verified email logs the user in, when this chat has a session id\n  login: ok && Boolean(sessionId),\n  save: true,\n  userId: user.id,\n  verified: ok,\n  codeHash: ok ? '' : user.verify_code_hash,\n  expires: ok ? null : user.verify_expires,\n  attempts: ok ? 0 : attempts + 1,\n  message: !ok\n    ? 'Invalid or expired code.'\n    : sessionId\n      ? 'Email verified. You are now logged in.'\n      : 'Email verified. You can now log in.',\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

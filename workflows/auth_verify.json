    {
      "parameters": {
        "jsCode": "const user = $('Find user for verify').first().json;\nconst given = $('Trigger').first().json.code;\nconst candidate = $input.first().json.candidate_hash;\nconst MAX_ATTEMPTS = 5;\nconst refuse = (message) => [{ json: { ok: false, save: false, message } }];\n\nif (!user.id) return refuse('Invalid or expired code.');\nif (user.email_verified === true) return refuse('This email is already verified. You can log in.');\nif (!user.verify_code_hash || !user.verify_expires || new Date(user.verify_expires) <= new Date()) {\n  return refuse('Invalid or expired code. Ask for a new code.');\n}\nconst attempts = user.verify_attempts || 0;\nif (attempts >= MAX_ATTEMPTS) return refuse('Too many attempts. Ask for a new code.');\n\nconst ok = /^\\d{6}$/.test(given) && candidate === user.verify_code_hash;\nreturn [{ json: {\n  ok,\n  save: true,\n  userId: user.id,\n  verified: ok,\n  codeHash: ok ? '' : user.verify_code_hash,\n  expires: ok ? null : user.verify_expires,\n  attempts: ok ? 0 : attempts + 1,\n  message: ok ? 'Email verified. You can now log in.' : 'Invalid or expired code.',\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

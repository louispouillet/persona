    {
      "parameters": {
        "jsCode": "const user = $input.first().json;\nconst email = $('Trigger').first().json.email;\n// same answer whether or not the account exists, so emails cannot be probed\nconst message = 'If this account exists and is not verified yet, a new code was sent. A new code can be requested once per minute.';\nif (!user.id || user.email_verified === true) {\n  return [{ json: { ok: false, message } }];\n}\n// the code was sent (expiry minus 15 minutes) less than a minute ago\nif (user.verify_expires && new Date(user.verify_expires).getTime() - 14 * 60 * 1000 > Date.now()) {\n  return [{ json: { ok: false, message } }];\n}\nreturn [{ json: { ok: true, id: user.id, email: user.email, salt: user.salt, message } }];"
      },

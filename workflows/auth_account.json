    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nif (!s.id || !s.user_id || !s.expires_at || new Date(s.expires_at) <= new Date()) {\n  return [{ json: { ok: false, message: 'You must be logged in to delete your account.' } }];\n}\nreturn [{ json: { ok: true, userId: s.user_id } }];"

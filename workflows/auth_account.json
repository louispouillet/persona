    {
      "parameters": {
        "jsCode": "const user = $('Find account user').first().json;\nconst candidate = $input.first().json.candidate_hash;\nconst refused = 'Incorrect password. The account was not deleted.';\nif (!user.id) return [{ json: { ok: false, message: 'Account not found.' } }];\nif (user.locked_until && new Date(user.locked_until) > new Date()) {\n  return [{ json: { ok: false, userId: user.id, failed: user.failed_logins || 0, lockedUntil: user.locked_until, message: refused } }];\n}\nconst ok = candidate === user.password_hash;\n// once a lock has expired, start a fresh series of attempts\nconst previous = (user.failed_logins || 0) >= 5 ? 0 : (user.failed_logins || 0);\nconst failed = ok ? 0 : previous + 1;\nconst lockedUntil = !ok && failed >= 5 ? new Date(Date.now() + 15 * 60 * 1000).toISOString() : null;\nreturn [{ json: { ok, userId: user.id, failed, lockedUntil, message: ok ? 'Account deleted.' : refused } }];"
      },

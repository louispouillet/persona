        "jsCode": "function toMessage(result) {\n  if (result.sent === true) {\n    return `Your newsletter with ${result.article_count} articles has been sent to your email address.`;\n  }\n  if (result.reason === 'no_matching_articles') {\n    return 'There are no new articles matching your interests since your last newsletter. Try again later or add more interests.';\n  }\n  return 'The newsletter could not be sent right now. Please try again later.';\n}\n\nreturn [{ json: { message: toMessage($input.first().json) } }];\n"

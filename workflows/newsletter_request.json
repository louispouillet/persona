    {
      "parameters": {
        "jsCode": "function getRefusal(user) {\n  if (!user.id) {\n    return 'Account not found.';\n  }\n  if (user.email_verified !== true) {\n    return 'Verify your email address first: enter the code you received by email.';\n  }\n  if (user.unsubscribed === true) {\n    return 'You are unsubscribed from the newsletter. Subscribe again first to receive it.';\n  }\n  return '';\n}\n\nconst user = $input.first().json;\nconst refusal = getRefusal(user);\n\nreturn [{ json: { ok: refusal === '', message: refusal, user_id: user.id } }];\n"
      },

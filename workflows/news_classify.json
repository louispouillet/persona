            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "summary": "={{ $json.summary }}",
            "categories": "={{ $json.categories }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "summary",

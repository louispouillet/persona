          "value": "articles"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "summary",
              "condition": "isEmpty"
            },
            {
              "keyName": "published_at",
              "condition": "gt",
              "keyValue": "={{ $now.minus({ days: 3 }).toISO() }}"
            }
          ]
        },
        "limit": 150,
        "orderBy": true,
        "orderByColumn": "published_at"
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        112
      ],
      "name": "Unprocessed articles",
      "alwaysOutputData": false,
      "id": "0ec586e5-80b7-46be-a9bb-bb8b9603ba30",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const BATCH_SIZE = 15;\nconst MAX_CONTENT_LENGTH = 500;\n\nfunction toPromptArticle(item) {\n  return {\n    id: item.json.id,\n    title: item.json.title,\n    content: (item.json.content || '').slice(0, MAX_CONTENT_LENGTH),\n  };\n}\n\nfunction splitIntoBatches(articles, batchSize) {\n  const batches = [];\n  for (let start = 0; start < articles.length; start += batchSize) {\n    batches.push(articles.slice(start, start + batchSize));\n  }\n  return batches;\n}\n\nfunction toBatchItem(articles) {\n  return { json: { articles } };\n}\n\nconst articles = $input.all().map(toPromptArticle);\nreturn splitIntoBatches(articles, BATCH_SIZE).map(toBatchItem);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        112
      ],
      "name": "Batches of 15",
      "id": "a8d46134-4a3b-461e-a0b5-75143fe79bfa"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a news editor. For each article below, write:\n- summary: 1 or 2 sentences in English, 40 words max, factual, no opinion\n- categories: 1 to 3 values, ONLY from this list: tech, science, business, politics, world, health, sports, culture, environment, entertainment\n\nReturn exactly one result per article, with the same id. Some articles are in French: always answer in English.\n\nArticles (JSON):\n{{ JSON.stringify($json.articles) }}",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 7000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        720,
        112
      ],
      "name": "Summarize and categorize",
      "id": "328e1538-1cc6-4d59-bec3-43259bc45be7",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "maxOutputTokens": 8192,
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        640,
        320
      ],
      "name": "Gemini",
      "id": "2c236e41-0f24-4c5f-85a6-f245fe861fba",
      "credentials": {
        "googlePalmApi": {
          "id": "kB5KBhp12r9B2z98",
          "name": "googlePalmApi"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"number\"\n          },\n          \"summary\": {\n            \"type\": \"string\"\n          },\n          \"categories\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"summary\",\n          \"categories\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"results\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        832,
        320
      ],
      "name": "JSON results",
      "id": "5fed7e01-4491-4d18-9893-7306f3500694"
    },
    {
      "parameters": {
        "jsCode": "const ALLOWED_CATEGORIES = ['tech', 'science', 'business', 'politics', 'world', 'health', 'sports', 'culture', 'environment', 'entertainment'];\nconst MAX_CATEGORIES = 3;\n\nfunction getArticleId(item) {\n  return item.json.id;\n}\n\nfunction getBatchResults(batch) {\n  return batch.json.output?.results || [];\n}\n\nfunction normalizeCategory(category) {\n  return String(category).toLowerCase().trim();\n}\n\nfunction isAllowedCategory(category) {\n  return ALLOWED_CATEGORIES.includes(category);\n}\n\nfunction cleanCategories(categories) {\n  const normalized = (categories || []).map(normalizeCategory);\n  return [...new Set(normalized)].filter(isAllowedCategory).slice(0, MAX_CATEGORIES);\n}\n\nfunction toArticleUpdate(result) {\n  return {\n    id: result.id,\n    summary: String(result.summary || '').trim(),\n    categories: cleanCategories(result.categories),\n  };\n}\n\nfunction isValidUpdate(update) {\n  return sentArticleIds.has(update.id) && update.summary !== '' && update.categories.length > 0;\n}\n\nfunction keepFirstPerId(updates) {\n  const seenIds = new Set();\n  const uniqueUpdates = [];\n  for (const update of updates) {\n    if (!seenIds.has(update.id)) {\n      seenIds.add(update.id);\n      uniqueUpdates.push(update);\n    }\n  }\n  return uniqueUpdates;\n}\n\nfunction toItem(update) {\n  return { json: { id: update.id, summary: update.summary, categories: update.categories.join(',') } };\n}\n\nconst sentArticleIds = new Set($('Unprocessed articles').all().map(getArticleId));\nconst validUpdates = $input.all().flatMap(getBatchResults).map(toArticleUpdate).filter(isValidUpdate);\nreturn keepFirstPerId(validUpdates).map(toItem);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,

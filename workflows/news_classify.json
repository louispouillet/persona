      "id": "bcf58cef-fbde-4cd0-8dc7-13947717000b"
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "articles"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "summary",
              "condition": "isEmpty"
            },
            {
              "keyName": "published_at",
              "condition": "gt",
              "keyValue": "={{ $now.minus({ days: 3 }).toISO() }}"
            }
          ]
        },
        "limit": 150,
        "orderBy": true,
        "orderByColumn": "published_at"
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        112
      ],
      "name": "Unprocessed articles",
      "alwaysOutputData": false,
      "id": "0ec586e5-80b7-46be-a9bb-bb8b9603ba30",
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Groups articles in batches of 15: one AI call per batch instead of one per article.\nconst BATCH_SIZE = 15;\nconst articles = $input.all().map(item => ({\n  id: item.json.id,\n  title: item.json.title,\n  content: (item.json.content || '').slice(0, 500),\n}));\n\nconst batches = [];\nfor (let i = 0; i < articles.length; i += BATCH_SIZE) {\n  batches.push({ json: { articles: articles.slice(i, i + BATCH_SIZE) } });\n}\nreturn batches;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        112
      ],
      "name": "Batches of 15",
      "id": "a8d46134-4a3b-461e-a0b5-75143fe79bfa"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a news editor. For each article below, write:\n- summary: 1 or 2 sentences in English, 40 words max, factual, no opinion\n- categories: 1 to 3 values, ONLY from this list: tech, science, business, politics, world, health, sports, culture, environment, entertainment\n\nReturn exactly one result per article, with the same id. Some articles are in French: always answer in English.\n\nArticles (JSON):\n{{ JSON.stringify($json.articles) }}",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 7000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        720,
        112
      ],
      "name": "Summarize and categorize",
      "id": "328e1538-1cc6-4d59-bec3-43259bc45be7",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "maxOutputTokens": 8192,
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        640,
        320
      ],
      "name": "Gemini",
      "id": "2c236e41-0f24-4c5f-85a6-f245fe861fba",
      "credentials": {
        "googlePalmApi": {
          "id": "kB5KBhp12r9B2z98",
          "name": "googlePalmApi"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"number\"\n          },\n          \"summary\": {\n            \"type\": \"string\"\n          },\n          \"categories\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"type\": \"string\"\n            }\n          }\n        },\n        \"required\": [\n          \"id\",\n          \"summary\",\n          \"categories\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"results\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        832,
        320
      ],
      "name": "JSON results",
      "id": "5fed7e01-4491-4d18-9893-7306f3500694"
    },
    {
      "parameters": {
        "jsCode": "const ALLOWED = ['tech', 'science', 'business', 'politics', 'world', 'health', 'sports', 'culture', 'environment', 'entertainment'];\nconst sentIds = new Set($('Unprocessed articles').all().map(item => item.json.id));\nconst seen = new Set();\nconst articles = [];\n\nfor (const batch of $input.all()) {\n  for (const result of batch.json.output?.results || []) {\n    const categories = [...new Set((result.categories || []).map(c => String(c).toLowerCase().trim()))]\n      .filter(c => ALLOWED.includes(c))\n      .slice(0, 3);\n    const summary = String(result.summary || '').trim();\n\n    if (!sentIds.has(result.id) || seen.has(result.id) || !summary || categories.length === 0) continue;\n    seen.add(result.id);\n    articles.push({ json: { id: result.id, summary, categories: categories.join(',') } });\n  }\n}\nreturn articles;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        112
      ],
      "name": "Validate results",
      "id": "297e6422-e78e-408b-a7fd-dfa00964e1e5"
    },
    {
      "parameters": {

    {
      "parameters": {
        "jsCode": "const SEND_WINDOW_MINUTES = 60;\nconst FALLBACK_TIME_ZONE = 'Europe/Paris';\n\nfunction getUser(item) {\n  return item.json;\n}\n\nfunction getTimeZone(user) {\n  if (user.timezone && DateTime.now().setZone(user.timezone).isValid) {\n    return user.timezone;\n  }\n  return FALLBACK_TIME_ZONE;\n}\n\nfunction isSendTime(user, nowForUser) {\n  const sendTime = DateTime.fromFormat(user.send_hour || '', 'H:mm');\n  if (!sendTime.isValid) {\n    return false;\n  }\n  const windowStart = nowForUser.set({ hour: sendTime.hour, minute: sendTime.minute, second: 0, millisecond: 0 });\n  const windowEnd = windowStart.plus({ minutes: SEND_WINDOW_MINUTES });\n  return nowForUser >= windowStart && nowForUser < windowEnd;\n}\n\nfunction wasServedToday(user, nowForUser) {\n  if (!user.last_sent) {\n    return false;\n  }\n  const lastSentForUser = DateTime.fromISO(user.last_sent).setZone(nowForUser.zone);\n  return lastSentForUser.hasSame(nowForUser, 'day');\n}\n\nfunction isDue(user) {\n  const nowForUser = DateTime.now().setZone(getTimeZone(user));\n  return isSendTime(user, nowForUser) && !wasServedToday(user, nowForUser);\n}\n\nfunction toSendRequest(user) {\n  return { json: { user_id: user.id } };\n}\n\nreturn $input.all().map(getUser).filter(isDue).map(toSendRequest);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

    {
      "parameters": {
        "jsCode": "// Every field leaves this node as a string: '' means \"not provided\", never null/undefined.\nconst input = $input.first().json;\n// where each action goes: 0 Register, 1 Session, 2 Profile, 3 Verify, 4 Account (5 = unknown)\nconst ROUTES = { register: 0, login: 1, logout: 1, update_profile: 2, verify: 3, resend_code: 3, delete_account: 4 };\nconst action = Object.hasOwn(ROUTES, input.action) ? input.action : '';\nconst text = (v, max, trim = true) => {\n  if (typeof v !== 'string') return '';\n  return (trim ? v.trim() : v).slice(0, max);\n};\n\nreturn [{ json: {\n  action,\n  route: action ? ROUTES[action] : 5,\n  sessionId: text(input.sessionId, 128),\n  email: text(input.email, 254).toLowerCase(),\n  // a password may legitimately start or end with spaces\n  password: text(input.password, 256, false),\n  code: text(input.code, 10).replace(/\\s/g, ''),\n  consent: input.consent === true || input.consent === 'true',\n  language: text(input.language, 10).toLowerCase().split('-')[0],\n  interests: text(input.interests, 1000),\n  send_hour: text(input.send_hour, 10),\n  timezone: text(input.timezone, 64),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        16
      ],
